# The Invoice Bridge's settings (app/bridge/config.py). Copy to .env to change
# anything. Every setting has a working default, and most can also be changed
# live from the Invoice Bridge's Settings screen.

# --- data ----------------------------------------------------------------
# Database, documents, exports and backups. launch.py sets it: data\bridge
# from the source; installed, %APPDATA%\Ultimate Accountant\bridge (or Tally
# Invoice Bridge's own %APPDATA%\TallyInvoiceBridge\data, carried on with).
# DATA_DIR=./data/bridge
# A shared PostgreSQL server instead of the local SQLite file (needs
# `pip install psycopg2-binary`):
# DATABASE_URL=postgresql+psycopg2://user:password@server:5432/tally

# --- Tally ---------------------------------------------------------------
TALLY_HOST=localhost
TALLY_PORT=9000
# Off until you choose otherwise: with it off the app only reads from Tally.
TALLY_ALLOW_POST=false

# --- AI model (optional) -------------------------------------------------
# The app's own AI (app/backend/ai.py) is used when it is on this computer;
# OLLAMA_HOST is only for an Ollama you run yourself instead.
LLM_ENABLED=true
OLLAMA_HOST=http://localhost:11434
# Reads text and page images: scans, handwriting and Hindi go to it as pictures.
OLLAMA_MODEL=qwen3.5:4b

# --- review --------------------------------------------------------------
# At or above this, with no failed check and no likely duplicate, an entry is
# "clean" and can be exported with the others in one action.
AUTO_CLEAN_CONFIDENCE=0.90

# --- watched folder ------------------------------------------------------
WATCH_ENABLED=true
