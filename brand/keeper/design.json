  "narrative": {
    "northStar": "Tally, in your pocket",
    "rules": [
      { "name": "The One Bar Rule", "body": "Tally yellow means \"you are here\" and nothing else. A plain hover on a list row is ground grey, not yellow. Yellow appears on the row only when it becomes current (arrow keys, press). It is never used for a status, a badge or decoration.", "section": "colors" },
      { "name": "The Red Means Late Rule", "body": "Red is for overdue only. Errors on the office page use the same red (--bad) because they are the same kind of alarm. Red is never used for emphasis, brand or negative amounts in general.", "section": "colors" },
      { "name": "The Weight Not Family Rule", "body": "Use one sans family. Make things more important with weight, and quieter with ink-3.", "section": "typography" },
