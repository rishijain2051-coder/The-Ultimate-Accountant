# Your deployment of the desktop app (docs/configuration.md). Copy to deploy.env
# (git-ignored) and fill in before `python packaging/build_release.py`; build.spec
# packs it into the program. Public values only - never a secret here.

# The public GitHub repository whose releases installed copies check for updates.
UA_UPDATE_REPO=your-github-user/ultimate-accountant-releases

# The public half of your release-signing key (base64). Make the pair with:
#   python packaging/publish_release.py --make-key
UA_UPDATE_PUBLIC_KEY=

# Your control plane (control-plane/), for the office server and its clients.
UA_CONTROL_PLANE=https://your-control-plane.example
