# The control plane's settings (docs/configuration.md). In production they live in
# Vercel's project environment; on your PC, in %USERPROFILE%\.ultimate-accountant\office.env
# (read by `python -m cp.migrate` and dev.py). Never commit real values.
#   python scripts/office_secrets.py --generate   fills in the generated keys
#   python scripts/office_secrets.py              checks what is filled in

# This control plane's own address: https://..., no path.
PUBLIC_ORIGIN=https://your-control-plane.example

# Supabase: the transaction pooler (port 6543), with your password in it.
DATABASE_URL=postgresql://postgres.your-project:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# CP_SCHEMA=office

# Google OAuth "Web application" client. Redirect URI: PUBLIC_ORIGIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2: a private bucket and a token for its objects only.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=your-r2-bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Generated by scripts/office_secrets.py --generate.
JWT_SIGNING_KEY=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
CRON_SECRET=
